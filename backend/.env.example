# Copy this to .env for local development
# NEVER commit the actual .env file — it is in .gitignore

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (required in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_campus_events?retryWrites=true&w=majority

# JWT secret — use a long random string (min 32 chars)
JWT_SECRET=replace_with_a_very_long_random_secret_string_here

# Optional: OpenAI API key (leave blank to use Heuristic AI mode)
OPENAI_API_KEY=
